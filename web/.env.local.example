# Where the api is. The dashboard talks to this and nothing else.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Clerk sign-in. Leave empty for local development: Clerk is then not loaded at all,
# and the Account page's header sign-in (api with VELLATRY_DEV_AUTH=1) is used instead.
# Production (Vercel): the publishable key from Clerk -> API keys. No secret key is
# needed: the dashboard does no server-side auth, the api verifies every token.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# The public address of this site, for canonical links and social previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
