# Database (local: docker compose -f deploy/docker-compose.yml up -d)
DATABASE_URL=postgres://vellatry_app:vellatry@localhost:5433/vellatry
VELLATRY_TEST_DATABASE_URL=postgres://vellatry_app:vellatry@localhost:5433/vellatry_test
PORT=8080

# Auth. Production: Clerk. Local only: VELLATRY_DEV_AUTH=1 trusts an X-Dev-Email header.
CLERK_ISSUER=
CLERK_AUTHORIZED_PARTIES=
VELLATRY_DEV_AUTH=1
ALLOWED_ORIGINS=http://localhost:3000

# DataForSEO (https://app.dataforseo.com/api-access). Without these the Visibility
# engine requests no answers. The daily cap is on our own account, in USD.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_DAILY_USD=5

# LLM gateway. The per-item judge only runs with VELLATRY_ALLOW_JUDGE=1
# (design-partner phase), capped per tenant per day in USD.
ANTHROPIC_API_KEY=
VELLATRY_ALLOW_JUDGE=0
LLM_DAILY_USD_PER_TENANT=2
VELLATRY_CHEAP_MODEL=claude-haiku-4-5
VELLATRY_STRONG_MODEL=claude-opus-5
